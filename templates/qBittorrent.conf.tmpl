[Application]
FileLogger\Age=1
FileLogger\AgeType=1
FileLogger\Backup=true
FileLogger\DeleteOld=true
FileLogger\Enabled=true
FileLogger\MaxSizeBytes=66560
FileLogger\Path=/config/qBittorrent/logs

[BitTorrent]
Session\AddExtensionToIncompleteFiles=true
Session\AddTorrentStopped=false
Session\AddTrackersEnabled=true
# Coller la liste de trackers publics depuis ngosang/trackerslist
# https://raw.githubusercontent.com/ngosang/trackerslist/master/trackers_best.txt
# en separant chaque tracker par "\n" (litteral)
Session\AdditionalTrackers=
Session\AdditionalTrackersEnabled=true
Session\DefaultSavePath=/downloads/
Session\GlobalMaxInactiveSeedingMinutes=4320
Session\GlobalMaxRatio=1
Session\GlobalMaxSeedingMinutes=10080
Session\MaxActiveDownloads=-1
Session\MaxActiveTorrents=-1
Session\MaxActiveUploads=-1
Session\Port=6881
Session\QueueingSystemEnabled=true
Session\ShareLimitAction=Pause
Session\SlowTorrentsDownloadRate=50
Session\SlowTorrentsInactivityTimer=600
Session\TempPath=/downloads/incomplete/

[Core]
AutoDeleteAddedTorrentFile=Never

[LegalNotice]
Accepted=true

[Network]
Cookies=@Invalid()
PortForwardingEnabled=false
Proxy\Type=None

[Preferences]
Connection\PortRangeMin=6881
Connection\UPnP=false
Downloads\SavePath=/downloads/
Downloads\TempPath=/downloads/incomplete/
General\Locale=en
WebUI\Address=*
# Whitelist : 127.0.0.1 (host) + 172.18.0.0/16 (docker homelab network)
# Permet aux scripts host + Sonarr/Radarr de joindre qBit sans password
WebUI\AuthSubnetWhitelist=127.0.0.1/8, 172.18.0.0/16
WebUI\AuthSubnetWhitelistEnabled=true
# Le password PBKDF2 est genere au premier boot par qBit
# Le recuperer dans les logs : docker logs qbittorrent | grep "temporary password"
WebUI\ServerDomains=*

[RSS]
AutoDownloader\DownloadRepacks=true
AutoDownloader\SmartEpisodeFilter=s(\\d+)e(\\d+), (\\d+)x(\\d+), "(\\d{4}[.\\-]\\d{1,2}[.\\-]\\d{1,2})", "(\\d{1,2}[.\\-]\\d{1,2}[.\\-]\\d{4})"
