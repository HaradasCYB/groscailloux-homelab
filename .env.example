# =============================================================================
# groscailloux-homelab — Configuration
# =============================================================================
# Copier en .env et remplir CHAQUE valeur CHANGE_ME avant de lancer setup.sh.
# Pour obtenir chaque secret/config, voir SECRETS.md
# =============================================================================

# -----------------------------------------------------------------------------
# Globaux
# -----------------------------------------------------------------------------

# Cle de chiffrement partagee par les services (Jellyseerr, Homarr, etc).
# Generer une nouvelle valeur : openssl rand -hex 32
SECRET_ENCRYPTION_KEY=CHANGE_ME

# Timezone (format IANA)
TZ=Europe/Paris

# IP publique du host (sert pour Jellyfin PublishedServerUrl)
HOST_IP=CHANGE_ME

# -----------------------------------------------------------------------------
# VPN — ProtonVPN Wireguard recommande (port forwarding requis pour seeding)
# -----------------------------------------------------------------------------
# Plans Plus/Visionary supportent NAT-PMP. Generer la cle Wireguard sur
# account.proton.me > WireGuard > coche "NAT-PMP (port forwarding)"
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=CHANGE_ME
WIREGUARD_ADDRESSES=10.2.0.2/32
SERVER_COUNTRIES=France

# -----------------------------------------------------------------------------
# Domaine dynamique (DuckDNS gratuit)
# -----------------------------------------------------------------------------
# Inscription : https://www.duckdns.org
DUCKDNS_SUBDOMAIN=CHANGE_ME
DUCKDNS_TOKEN=CHANGE_ME

# -----------------------------------------------------------------------------
# InfluxDB (metriques Telegraf -> Grafana)
# -----------------------------------------------------------------------------
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=CHANGE_ME
INFLUXDB_INIT_ORG=homelab
INFLUXDB_INIT_BUCKET=metrics

# -----------------------------------------------------------------------------
# Grafana
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# MySQL (base de Apache Guacamole)
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=CHANGE_ME
GUACAMOLE_DB_NAME=guacamole_db
GUACAMOLE_DB_USER=guacamole_user
MYSQL_USER_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# API keys des services (recuperees apres premier boot via UI Settings)
# Necessaires pour les scripts d'automation (auto-import, qbit handlers, etc.)
# -----------------------------------------------------------------------------
RADARR_API_KEY=CHANGE_ME
SONARR_API_KEY=CHANGE_ME
JELLYFIN_API_KEY=CHANGE_ME
JELLYSEERR_API_KEY=CHANGE_ME
JACKETT_API_KEY=CHANGE_ME
PROWLARR_API_KEY=CHANGE_ME

# Indexer prive optionnel
C411_API_KEY=

# -----------------------------------------------------------------------------
# URLs publiques (apres config DuckDNS + NPM)
# Utilisees dans le mail d'onboarding utilisateur
# -----------------------------------------------------------------------------
JELLYFIN_PUBLIC_URL=https://jellyfin.example.com
JELLYSEERR_PUBLIC_URL=https://jellyseerr.example.com

# -----------------------------------------------------------------------------
# Jellyfin libraries (recuperer apres init Jellyfin)
# Settings > Libraries > clic chaque lib > URL contient le GUID
# -----------------------------------------------------------------------------
JELLYFIN_LIB_FILMS=CHANGE_ME
JELLYFIN_LIB_SERIES=CHANGE_ME

# -----------------------------------------------------------------------------
# SMTP (Gmail App Password recommande)
# Pour envoyer le mail d'onboarding unifie aux nouveaux users
# myaccount.google.com/apppasswords (necessite 2FA active)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM=CHANGE_ME
SMTP_FROM_NAME=Homelab

# Email admin (recoit les notifications Jellyseerr)
ADMIN_EMAIL=CHANGE_ME

# -----------------------------------------------------------------------------
# Repertoires (laisser par defaut pour deploiement standard)
# -----------------------------------------------------------------------------
HOMELAB_BASE_DIR=/opt/homelab
HOMELAB_DOWNLOADS_DIR=/opt/homelab/downloads
HOMELAB_MEDIA_DIR=/opt/homelab/media
HOMELAB_LOGS_DIR=/opt/homelab/logs

# Quality profile par defaut pour les ajouts auto Sonarr/Radarr
QUALITY_PROFILE_ID=6
