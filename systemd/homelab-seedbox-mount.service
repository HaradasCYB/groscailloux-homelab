[Unit]
Description=Seedbox media (SFTP) mounted on /mnt/seedbox/media for Jellyfin (writable: deletions from Jellyfin)
Wants=network-online.target
After=network-online.target

[Service]
# Montage dans un sous-dossier : le conteneur Jellyfin lie /mnt/seedbox (dossier ordinaire, rslave),
# chaque (re)montage FUSE se propage donc dans le conteneur sans le recréer.
Type=notify
User=deploy
Group=deploy
# Hôte SFTP et compte de la seedbox : hors du dépôt public (SEEDBOX_SFTP_HOST, SEEDBOX_USER dans .env). Le script
# les écrit DANS la config effective /run/homelab-seedbox-mount/rclone.conf (600, refaite à chaque démarrage depuis le
# modèle rclone/rclone.conf) ; variable absente, vide ou invalide : refus qui la nomme dans le journal.
# CACHE VFS : rclone ajoute au nom interne du remote un suffixe tiré des options de backend données en ligne de
# commande ou par variable RCLONE_* (« seedbox{9oylk} » pour --sftp-connections 32 seul), et ce nom est celui du
# dossier du cache (cache/rclone/vfs/seedbox{9oylk}, 120 Go). Toute option --sftp-* ajoutée, retirée ou changée ici
# change donc de dossier et abandonne le cache : tous les titres seedbox repassent par le lien, et l'ancien dossier reste
# sur le disque sans que rclone le purge (déjà vu le 19/09 : cache/rclone/vfs/seedbox, ~20 Go). Un réglage SFTP
# nouveau va dans le modèle rclone/rclone.conf, sans effet sur le nom. Pas d'EnvironmentFile : rclone ne reçoit rien
# de .env (ni secret, ni RCLONE_*).
RuntimeDirectory=homelab-seedbox-mount
RuntimeDirectoryMode=0700
ExecStartPre=/opt/homelab/scripts/seedbox-rclone-conf.sh /opt/homelab/rclone/rclone.conf /run/homelab-seedbox-mount/rclone.conf
ExecStartPre=/bin/mkdir -p /opt/homelab/cache/rclone
ExecStart=/usr/local/bin/rclone mount seedbox:media /mnt/seedbox/media \
  --config /run/homelab-seedbox-mount/rclone.conf \
  --allow-other --umask 022 \
  --vfs-cache-mode full --vfs-cache-max-size 120G --vfs-cache-max-age 168h \
  --vfs-cache-min-free-space 80G \
  --cache-dir /opt/homelab/cache/rclone \
  --vfs-read-chunk-size 4M --vfs-read-chunk-streams 4 --buffer-size 32M \
  --sftp-connections 32 \
  --dir-cache-time 1h --attr-timeout 1h \
  --rc --rc-addr 127.0.0.1:5572 --rc-no-auth \
  --log-level INFO
ExecStop=/bin/fusermount3 -uz /mnt/seedbox/media
# rclone sort en 143 (128 + SIGTERM) sur un arrêt voulu : le chien de garde du montage et `systemctl restart` ne
# doivent pas laisser « Failed with result 'exit-code' » (vu les 14:05 et 17:35 du 27/09). Effet à la prochaine
# relance voulue, sans en imposer une.
SuccessExitStatus=143
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
