[Unit]
Description=Homelab auto-import watcher (pyload/manual drops → Sonarr/Radarr)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
ExecStart=/opt/homelab/auto-import.sh
Restart=on-failure
RestartSec=10
StandardOutput=append:/opt/homelab/logs/auto-import-systemd.log
StandardError=append:/opt/homelab/logs/auto-import-systemd.log

[Install]
WantedBy=multi-user.target
