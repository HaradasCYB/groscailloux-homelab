[Unit]
Description=Sync Sonarr seasons[].monitored with Jellyseerr season_request entries
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
ExecStart=/opt/homelab/scripts/jellyseerr-sonarr-monitor-sync.sh
StandardOutput=append:/opt/homelab/logs/jellyseerr-sonarr-monitor-sync-systemd.log
StandardError=append:/opt/homelab/logs/jellyseerr-sonarr-monitor-sync-systemd.log
