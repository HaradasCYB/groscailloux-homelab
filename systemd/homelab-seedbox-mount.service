[Unit]
Description=Seedbox media (SFTP) mounted on /mnt/seedbox/media for Jellyfin (writable: deletions from Jellyfin)
Wants=network-online.target
After=network-online.target

[Service]
# Montage dans un sous-dossier : le conteneur Jellyfin lie /mnt/seedbox (dossier ordinaire, rslave),
# chaque (re)montage FUSE se propage donc dans le conteneur sans le recréer.
Type=notify
User=deploy
Group=deploy
# Hôte SFTP et compte de la seedbox : hors du dépôt public (SEEDBOX_SFTP_HOST, SEEDBOX_USER dans .env), passés en
# options (elles l'emportent sur rclone.conf). Variable absente ou vide : refus nommé dans le journal (`$$` = `$` lu
# par sh, pas par systemd), sinon rclone partirait sans hôte.
EnvironmentFile=/opt/homelab/.env
ExecStartPre=/bin/sh -c 'test -n "$${SEEDBOX_SFTP_HOST}" && test -n "$${SEEDBOX_USER}" || { echo "SEEDBOX_SFTP_HOST ou SEEDBOX_USER absent de /opt/homelab/.env" >&2; exit 1; }'
ExecStartPre=/bin/mkdir -p /opt/homelab/cache/rclone
ExecStart=/usr/local/bin/rclone mount seedbox:media /mnt/seedbox/media \
  --config /opt/homelab/rclone/rclone.conf \
  --sftp-host ${SEEDBOX_SFTP_HOST} --sftp-user ${SEEDBOX_USER} \
  --allow-other --umask 022 \
  --vfs-cache-mode full --vfs-cache-max-size 120G --vfs-cache-max-age 168h \
  --vfs-cache-min-free-space 80G \
  --cache-dir /opt/homelab/cache/rclone \
  --vfs-read-chunk-size 4M --vfs-read-chunk-streams 4 --buffer-size 32M \
  --sftp-connections 32 \
  --dir-cache-time 1h --attr-timeout 1h \
  --rc --rc-addr 127.0.0.1:5572 --rc-no-auth \
  --log-level INFO
ExecStop=/bin/fusermount3 -uz /mnt/seedbox/media
# rclone sort en 143 (128 + SIGTERM) sur un arrêt voulu : le chien de garde du montage et `systemctl restart` ne
# doivent pas laisser « Failed with result 'exit-code' » (vu les 14:05 et 17:35 du 27/09). Effet à la prochaine
# relance voulue, sans en imposer une.
SuccessExitStatus=143
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
