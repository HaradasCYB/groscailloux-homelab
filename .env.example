# groscailloux-homelab — configuration d'hôte et secrets.
# Copier en .env (chmod 600) et remplir chaque valeur vide. Voir SECRETS.md.
# Ce fichier est lu par docker compose (interpolation ${VAR}) ET par homelabd/homelabctl.
# Pas de guillemets sauf si la valeur contient un espace.

# --- Global
TZ=Europe/Paris
HOST_IP=                       # IP publique du VPS (Jellyfin PublishedServerUrl)
JELLYFIN_PUBLIC_URL=           # ex: https://jellyfin.mondomaine.duckdns.org
JELLYSEERR_PUBLIC_URL=         # ex: https://jellyseerr.mondomaine.duckdns.org
SECRET_ENCRYPTION_KEY=         # openssl rand -hex 32 (Homarr)

# --- DuckDNS
DUCKDNS_SUBDOMAIN=             # sans .duckdns.org
DUCKDNS_TOKEN=

# --- VPN (gluetun) — ProtonVPN WireGuard avec NAT-PMP pour le port forwarding
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=10.2.0.2/32
SERVER_COUNTRIES=France

# --- InfluxDB / Telegraf
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=
INFLUXDB_INIT_ORG=homelab
INFLUXDB_INIT_BUCKET=metrics
INFLUX_TOKEN=                  # token opérateur, injecté dans telegraf/etc/telegraf.conf par setup.sh

# --- Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# --- Guacamole / MySQL
MYSQL_ROOT_PASSWORD=
GUACAMOLE_DB_NAME=guacamole_db
GUACAMOLE_DB_USER=guacamole_user
MYSQL_USER_PASSWORD=

# --- Clés API (Settings → General de chaque service, après premier démarrage)
SONARR_API_KEY=
RADARR_API_KEY=
PROWLARR_API_KEY=
JELLYFIN_API_KEY=              # Dashboard → API Keys
JELLYSEERR_API_KEY=            # Settings → General

# --- Jellyfin : GUID des bibliothèques (URL de la bibliothèque dans le dashboard)
JELLYFIN_LIB_FILMS=
JELLYFIN_LIB_SERIES=
JELLYFIN_LIB_EXTRA=             # ids supplémentaires (virgules) donnés aux nouveaux comptes (vide : seedbox incluse dans Films/Séries)
QUALITY_PROFILE_ID=6           # profil qualité Sonarr/Radarr utilisé par auto_import

# --- SMTP (mail d'onboarding et notifications diun) — Gmail : mot de passe d'application
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME="Jellyseerr Groscailloux"
ADMIN_EMAIL=                   # destinataire des notifications diun

# --- homelabd
HOMELABD_ONBOARD_TOKEN=        # openssl rand -hex 32 ; requis par POST /onboard (page ouverte avec ?token=…)
HOMELABD_STATUS_TOKEN=           # jeton de /status et /status.html (iFrame Homarr « Opérations »)
DONATION_PAYPAL_CLIENT_ID=       # page de don /don (bouton PayPal) ; vide = pas de page
DONATION_PAYPAL_PLAN_ID=         # plan PayPal (P-…) du don récurrent

# --- Profil compose actif : vpn (gluetun+qbittorrent) ou novpn (qbittorrent-direct). Géré par `homelabctl vpn`.
COMPOSE_PROFILES=vpn

# --- Seedbox (optionnelle, [seedbox] dans homelab.toml) : clés des apps installées via app-<x>
SEEDBOX_RADARR_API_KEY=
SEEDBOX_SONARR_API_KEY=
SEEDBOX_JACKETT_API_KEY=
SEEDBOX_QBIT_PASSWORD=         # mot de passe WebUI qBittorrent seedbox (client des Arrs seedbox)
SEEDBOX_JACKETT_PASSWORD=
SEEDBOX_RADARR_PASSWORD=
SEEDBOX_SONARR_PASSWORD=
SEEDBOX_BAZARR_PASSWORD=
SEEDBOX_AUTOBRR_PASSWORD=

# --- Accès d'administration (générés, jamais commités)
NPM_ADMIN_TOOLS_PASSWORD=       # liste d'accès NPM « admin-outils » (utilisateur groscailloux) devant les outils d'admin
HOMARR_ADMIN_PASSWORD=          # compte Homarr « groscailloux » (admin, tableau Operations)
