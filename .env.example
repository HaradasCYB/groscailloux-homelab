# homelab — copier en .env et remplir CHAQUE valeur (voir SECRETS.md). Générer les tokens : openssl rand -hex 32

# --- Global
TZ=
HOST_IP=
JELLYFIN_PUBLIC_URL=
JELLYSEERR_PUBLIC_URL=
SECRET_ENCRYPTION_KEY=

# --- DuckDNS
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=

# --- VPN (gluetun)
VPN_SERVICE_PROVIDER=
VPN_TYPE=
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
SERVER_COUNTRIES=

# --- InfluxDB / Telegraf
INFLUXDB_INIT_USERNAME=
INFLUXDB_INIT_PASSWORD=
INFLUXDB_INIT_ORG=
INFLUXDB_INIT_BUCKET=
INFLUX_TOKEN=

# --- Grafana
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# --- Guacamole / MySQL
MYSQL_ROOT_PASSWORD=
GUACAMOLE_DB_NAME=
GUACAMOLE_DB_USER=
MYSQL_USER_PASSWORD=

# --- API keys services
SONARR_API_KEY=
RADARR_API_KEY=
PROWLARR_API_KEY=
JELLYFIN_API_KEY=
JELLYSEERR_API_KEY=

# --- Jellyfin libraries (GUID) et profil qualité Arr
JELLYFIN_LIB_FILMS=
JELLYFIN_LIB_SERIES=
QUALITY_PROFILE_ID=

# --- SMTP (mail d'onboarding)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=

# --- homelabd
HOMELABD_ONBOARD_TOKEN=

# --- Destinataire des notifications (diun, alertes)
ADMIN_EMAIL=

# --- Profil compose actif : vpn (gluetun+qbittorrent) ou novpn (qbittorrent-direct). Géré par `homelabctl vpn`.
COMPOSE_PROFILES=vpn
